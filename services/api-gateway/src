// Thin process launcher for the PulseWard API gateway.
// All routes and middleware live in ./app.js so the app can be imported by
// integration tests (via app.request()) and measured by coverage tooling.
import { serve } from '@hono/node-server';
import { app, PORT } from './app.js';

console.log(`\n🏥  PulseWard HMS — API Gateway (Hono + SQLite)`);
console.log(`    Port: ${PORT}\n`);

serve({ fetch: app.fetch, port: PORT }, (info) => {
  console.log(`✓ Listening on http://localhost:${info.port}\n`);
});
