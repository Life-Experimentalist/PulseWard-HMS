{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "services/**/*.js",
    "tests/**/*.js",
    "packages/**/*.js",
    "apps/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "build",
    "apps/**/dist"
  ]
}