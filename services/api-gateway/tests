const request = require('supertest');
const app = require('../src/app'); // Adjust the path as necessary to import your app

describe('API Gateway Tests', () => {
    it('should route to the patient service', async () => {
        const response = await request(app)
            .get('/api/patients/1') // Adjust the endpoint as necessary
            .expect(200);
        
        expect(response.body).toHaveProperty('id', 1);
    });

    it('should route to the clinician service', async () => {
        const response = await request(app)
            .get('/api/clinicians/1') // Adjust the endpoint as necessary
            .expect(200);
        
        expect(response.body).toHaveProperty('id', 1);
    });

    it('should return 404 for unknown routes', async () => {
        const response = await request(app)
            .get('/api/unknown') // Adjust the endpoint as necessary
            .expect(404);
        
        expect(response.body).toHaveProperty('error', 'Not Found');
    });

    it('should handle errors from services', async () => {
        const response = await request(app)
            .get('/api/patients/9999') // Assuming this ID does not exist
            .expect(404);
        
        expect(response.body).toHaveProperty('error', 'Patient not found');
    });

    // Add more tests as necessary to cover all routes and functionalities
});