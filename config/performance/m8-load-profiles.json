{
    "version": "1.0.0",
    "owner": "platform-operations",
    "defaultBaseUrl": "http://localhost:3000/api/v1",
    "profiles": [
        {
            "key": "auth-login",
            "service": "auth-service",
            "method": "POST",
            "path": "/auth/login",
            "workload": {
                "virtualUsers": 40,
                "durationSeconds": 300,
                "rampUpSeconds": 60
            },
            "thresholds": {
                "p95LatencyMs": 500,
                "errorRatePercent": 1
            }
        },
        {
            "key": "appointment-booking",
            "service": "appointment-service",
            "method": "POST",
            "path": "/appointments",
            "workload": {
                "virtualUsers": 50,
                "durationSeconds": 300,
                "rampUpSeconds": 60
            },
            "thresholds": {
                "p95LatencyMs": 700,
                "errorRatePercent": 1
            }
        },
        {
            "key": "notification-dispatch",
            "service": "notification-service",
            "method": "POST",
            "path": "/notifications/send",
            "workload": {
                "virtualUsers": 35,
                "durationSeconds": 300,
                "rampUpSeconds": 45
            },
            "thresholds": {
                "p95LatencyMs": 900,
                "errorRatePercent": 2
            }
        },
        {
            "key": "patient-read",
            "service": "patient-service",
            "method": "GET",
            "path": "/patients/{id}",
            "workload": {
                "virtualUsers": 60,
                "durationSeconds": 300,
                "rampUpSeconds": 45
            },
            "thresholds": {
                "p95LatencyMs": 450,
                "errorRatePercent": 1
            }
        },
        {
            "key": "patient-write",
            "service": "patient-service",
            "method": "PUT",
            "path": "/patients/{id}",
            "workload": {
                "virtualUsers": 30,
                "durationSeconds": 300,
                "rampUpSeconds": 60
            },
            "thresholds": {
                "p95LatencyMs": 700,
                "errorRatePercent": 1
            }
        }
    ]
}