# PulseWard HMS — Environment Variables
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored at runtime.

# ─── API GATEWAY ──────────────────────────────────────────────────────────────

# Port the Hono API gateway listens on (default 8787).
API_PORT=8787

# JWT signing secret — REQUIRED, and MUST be changed before any real deployment.
# In production (NODE_ENV=production) the gateway refuses to start when this is
# missing, under 32 characters, or left as the placeholder below.
# Generate a strong secret with: pnpm run jwt:generate
JWT_SECRET=change_me_jwt_secret_min_32_chars_random

# Comma-separated list of additional allowed CORS origins (production domains).
# Development localhost origins are always allowed automatically.
# Example: https://portal.yourhospital.com,https://admin.yourhospital.com
CORS_ALLOWED_ORIGINS=

# SQLite database file path.
# Defaults to pulseward.db next to the gateway entry file if unset.
# DB_PATH=/var/data/pulseward.db

# Node environment — set to "production" in prod.
NODE_ENV=development

# ─── FRONTEND DEV PORTS (Vite dev/preview only) ───────────────────────────────

PATIENT_PORTAL_PORT=4313
CLINICIAN_PORTAL_PORT=4311
ADMIN_CONSOLE_PORT=4180
OPS_DASHBOARD_PORT=4312
