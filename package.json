{
  "name": "pulseward-hms",
  "version": "1.2.0",
  "description": "PulseWard Hospital Management System - A comprehensive solution for managing hospital operations, patient care, and administrative tasks.",
  "main": "index.js",
  "scripts": {
    "start": "node services/api-gateway/src",
    "start:auth": "node services/auth-service/src",
    "start:notification": "node services/notification-service/src",
    "start:appointment": "node services/appointment-service/src",
    "start:landing": "node ./scripts/start-landing.mjs",
    "start:admin": "node ./scripts/start-admin.mjs",
    "start:clinician": "node ./scripts/start-clinician.mjs",
    "start:operations": "node ./scripts/start-operations.mjs",
    "start:patient": "node ./scripts/start-patient.mjs",
    "start:admin:dev": "npm --prefix ./apps/admin-console run dev -- --host",
    "start:clinician:dev": "npm --prefix ./apps/clinician-portal run dev -- --host",
    "start:operations:dev": "npm --prefix ./apps/operations-dashboard run dev -- --host",
    "start:patient:dev": "npm --prefix ./apps/patient-portal run dev -- --host",
    "install:admin": "npm --prefix ./apps/admin-console install",
    "install:clinician": "npm --prefix ./apps/clinician-portal install",
    "install:operations": "npm --prefix ./apps/operations-dashboard install",
    "install:patient": "npm --prefix ./apps/patient-portal install",
    "install:apps": "npm run install:admin && npm run install:clinician && npm run install:operations && npm run install:patient",
    "build:admin": "npm --prefix ./apps/admin-console run build",
    "build:clinician": "npm --prefix ./apps/clinician-portal run build",
    "build:operations": "npm --prefix ./apps/operations-dashboard run build",
    "build:patient": "npm --prefix ./apps/patient-portal run build",
    "build:apps": "npm run build:admin && npm run build:clinician && npm run build:operations && npm run build:patient",
    "build:admin:ci": "npm --prefix ./apps/admin-console ci --no-audit --no-fund && npm --prefix ./apps/admin-console run build",
    "build:clinician:ci": "npm --prefix ./apps/clinician-portal ci --no-audit --no-fund && npm --prefix ./apps/clinician-portal run build",
    "build:operations:ci": "npm --prefix ./apps/operations-dashboard ci --no-audit --no-fund && npm --prefix ./apps/operations-dashboard run build",
    "build:patient:ci": "npm --prefix ./apps/patient-portal ci --no-audit --no-fund && npm --prefix ./apps/patient-portal run build",
    "build:apps:ci": "npm run build:admin:ci && npm run build:clinician:ci && npm run build:operations:ci && npm run build:patient:ci",
    "test": "jest",
    "test:smoke": "node ./scripts/smoke-test-platform.mjs",
    "test:routes": "node -e \"require('./services/auth-service/routes'); require('./services/notification-service/routes'); require('./services/appointment-service/routes'); require('./services/ehr-service/routes'); require('./services/lab-service/routes'); require('./services/pharmacy-service/src'); require('./services/billing-service/src'); console.log('Route modules loaded');\"",
    "contracts:check": "node ./scripts/check-contract-coverage.mjs",
    "build": "npm run build:apps",
    "build:types": "tsc --noEmit",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{js,mjs,ts,json,md,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,json,md,yml,yaml,css,html}\"",
    "quality:check": "npm run lint && npm run format:check && npm run test:routes && npm run test:smoke",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "demo:up": "powershell -ExecutionPolicy Bypass -File ./scripts/demo-up.ps1",
    "demo:down": "powershell -ExecutionPolicy Bypass -File ./scripts/demo-down.ps1",
    "demo:opd": "powershell -ExecutionPolicy Bypass -File ./scripts/demo-opd-flow.ps1",
    "visuals:generate": "node ./scripts/generate-mermaid-visuals.mjs",
    "integrations:validate": "node ./scripts/validate-integration-config.mjs"
  },
  "author": "VKrishna04",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0",
    "nodemailer": "^8.0.4"
  },
  "devDependencies": {
    "eslint": "^7.11.0",
    "http-server": "^14.1.1",
    "jest": "^30.3.0",
    "prettier": "^2.2.1",
    "typescript": "^4.1.3"
  },
  "icon": "",
  "contributors": [
    {
      "email": "me@vkrishna04.me",
      "name": "VKrishna04",
      "url": "https://vkrishna04.me"
    },
    {
      "email": "github@vkrishna04.me",
      "name": "Life Experimentalist",
      "url": "https://github.com/Life-Experimentalist/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Life-Experimentalist/PulseWard-HMS.git"
  },
  "keywords": [
    "hospital",
    "management",
    "system",
    "healthcare",
    "patient",
    "clinician",
    "admin"
  ]
}