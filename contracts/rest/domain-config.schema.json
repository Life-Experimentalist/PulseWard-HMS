{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseward.local/schemas/domain-config.schema.json",
  "title": "DomainConfig",
  "type": "object",
  "required": ["platform", "tenants"],
  "properties": {
    "platform": {
      "type": "object",
      "required": ["hostingMode", "githubSubdomain", "primaryCustomDomain", "apiBasePath"],
      "properties": {
        "hostingMode": {
          "type": "string",
          "enum": ["github-subdomain", "custom-domain", "hybrid"]
        },
        "githubSubdomain": {
          "type": "string",
          "format": "uri"
        },
        "primaryCustomDomain": {
          "type": "string",
          "format": "uri"
        },
        "apiBasePath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tenantKey", "landingDomain", "apiDomain", "allowedOrigins"],
        "properties": {
          "tenantKey": {
            "type": "string"
          },
          "landingDomain": {
            "type": "string",
            "format": "uri"
          },
          "apiDomain": {
            "type": "string",
            "format": "uri"
          },
          "allowedOrigins": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
