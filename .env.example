# Contents of the file: /PulseWard-HMS/PulseWard-HMS/.env.example

# Example Environment Variable Configuration for PulseWard Hospital Management System

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulseward
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# API configuration
API_PORT=3000
API_BASE_URL=http://localhost:3000/api

# Service ports (set unique values to avoid local clashes)
AUTH_SERVICE_PORT=5101
NOTIFICATION_SERVICE_PORT=5102
APPOINTMENT_SERVICE_PORT=5103
LANDING_PORT=4173
ADMIN_CONSOLE_PORT=4180

# Comma-separated allowed browser origins for service CORS.
# Use * for local demos across localhost/LAN origins.
CORS_ALLOWED_ORIGINS=*

# Authentication configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=1h

# Email service configuration
EMAIL_SERVICE=your_email_service
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password

# Third-party API keys
PHARMACY_API_KEY=your_pharmacy_api_key
LAB_API_KEY=your_lab_api_key

# Integration provider credentials references
INTEGRATION_WHATSAPP_CREDENTIALS=your_whatsapp_credentials_reference
INTEGRATION_TELEGRAM_CREDENTIALS=your_telegram_credentials_reference
INTEGRATION_EMAIL_SMTP_CREDENTIALS=your_email_smtp_credentials_reference
INTEGRATION_GOOGLE_CALENDAR_CREDENTIALS=your_google_calendar_credentials_reference
INTEGRATION_APPLE_CALENDAR_CREDENTIALS=your_apple_calendar_credentials_reference
INTEGRATION_OUTLOOK_CALENDAR_CREDENTIALS=your_outlook_calendar_credentials_reference
INTEGRATION_ICS_CREDENTIALS=your_ics_credentials_reference

# OAuth and external auth
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8081/api/v1/auth/oauth/google/callback
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Optional ABHA/NDHM integration profile
ABHA_ENABLED=false
ABHA_ENVIRONMENT=sandbox
ABHA_CLIENT_ID=your_abha_client_id
ABHA_CLIENT_SECRET=your_abha_client_secret
ABHA_GATEWAY_BASE_URL=https://abha-gateway.example.com

# Domain and tenant routing
PLATFORM_PRIMARY_DOMAIN=https://pulseward.example.com
PLATFORM_GITHUB_SUBDOMAIN=https://life-experimentalist.github.io/pulseward-hms

# Optional low-cost push (Firebase)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# AI Agent configuration
AI_AGENT_URL=http://localhost:5000
AI_AGENT_API_KEY=your_ai_agent_api_key

# Logging configuration
LOG_LEVEL=info
LOG_FILE=logs/pulseward.log

# Other configurations
NODE_ENV=development

# Additional runtime overrides and integration guardrail defaults
# Keep these aligned with service fallback values for deterministic local behavior.
ABHA_TRANSACTION_WRITE_PATH=/v1/records/write
AUTH_SERVICE_BASE_URL=http://localhost:5101
NOTIFICATION_SERVICE_BASE_URL=http://localhost:5102
APPOINTMENT_SERVICE_BASE_URL=http://localhost:5103
CLINICIAN_PORT=4181
OPERATIONS_PORT=4182
PATIENT_PORT=4183
AUTH_ADMIN_SETTINGS_STORE_PATH=services/auth-service/data/admin-console-settings.json
APPOINTMENT_NOTIFICATION_EVENT_ENDPOINT=
APPOINTMENT_NOTIFICATION_ENDPOINT=
APPOINTMENT_NOTIFICATION_MAX_RETRIES=3
APPOINTMENT_NOTIFICATION_TIMEOUT_MS=1500
APPOINTMENT_NOTIFICATION_LATE_THRESHOLD_MS=120000
APPOINTMENT_NOTIFICATION_DEAD_LETTER_MAX=500
INTEGRATION_FAULT_INJECTION_RETENTION_MAX=200
INTEGRATION_FAULT_MANIFEST_MAX_AGE_SECONDS=900
INTEGRATION_FAULT_MANIFEST_CLOCK_SKEW_SECONDS=60
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_WINDOW_SECONDS=600
INTEGRATION_FAULT_MANIFEST_VERIFY_DEDUPE_WINDOW_SECONDS=600
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_MAX_ENTRIES=500
INTEGRATION_FAULT_MANIFEST_VERIFY_DEDUPE_MAX_ENTRIES=500
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_SATURATION_WARNING_PERCENT=75
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_SATURATION_CRITICAL_PERCENT=90
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_SATURATION_TREND_MAX_SNAPSHOTS=288
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ANOMALY_INSTANCE_MAX=500
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ANOMALY_ACTION_MAX=1000
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ANOMALY_RETENTION_WINDOW_SECONDS=86400
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ANOMALY_NOTE_MAX_LENGTH=1000
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ANOMALY_NOTES_PER_INSTANCE_MAX=20
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ESCALATION_ENABLED=true
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ESCALATION_EXPORT_ENABLED=true
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ESCALATION_EXPORT_MAX_ROWS=1000
INTEGRATION_FAULT_MANIFEST_VERIFY_ATTEMPT_RETENTION_ESCALATION_MITIGATION_NOTE_TYPES=mitigation-plan,mitigation-applied,mitigation
INTEGRATION_RETRY_POLICY=exponential-backoff
INTEGRATION_RETRY_MAX_ATTEMPTS=3
INTEGRATION_RETRY_BASE_DELAY_MS=500
INTEGRATION_RETRY_MAX_DELAY_MS=5000
INTEGRATION_RETRY_JITTER=true
INTEGRATION_WEBHOOK_ENDPOINT=
CONTRACT_CHECK_SPEC_OVERRIDES=
VITE_NOTIFICATION_PROXY_TARGET=http://127.0.0.1:8088
VITE_AUTH_PROXY_TARGET=http://127.0.0.1:5101
ABHA_TRANSACTION_READ_PATH=/v1/records/read
