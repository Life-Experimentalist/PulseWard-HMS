const request = require('supertest');
const app = require('../src/app'); // Adjust the path as necessary

describe('Billing Service Tests', () => {
    let billingId;

    // Test case for creating a new billing record
    it('should create a new billing record', async () => {
        const response = await request(app)
            .post('/api/billing')
            .send({
                patientId: '12345',
                amount: 150.00,
                status: 'Pending'
            });

        expect(response.status).toBe(201);
        expect(response.body).toHaveProperty('id');
        billingId = response.body.id; // Store the billing ID for later tests
    });

    // Test case for retrieving a billing record
    it('should retrieve a billing record', async () => {
        const response = await request(app)
            .get(`/api/billing/${billingId}`);

        expect(response.status).toBe(200);
        expect(response.body).toHaveProperty('id', billingId);
    });

    // Test case for updating a billing record
    it('should update a billing record', async () => {
        const response = await request(app)
            .put(`/api/billing/${billingId}`)
            .send({
                status: 'Paid'
            });

        expect(response.status).toBe(200);
        expect(response.body).toHaveProperty('status', 'Paid');
    });

    // Test case for deleting a billing record
    it('should delete a billing record', async () => {
        const response = await request(app)
            .delete(`/api/billing/${billingId}`);

        expect(response.status).toBe(204);
    });

    // Test case for retrieving all billing records
    it('should retrieve all billing records', async () => {
        const response = await request(app)
            .get('/api/billing');

        expect(response.status).toBe(200);
        expect(Array.isArray(response.body)).toBe(true);
    });
});