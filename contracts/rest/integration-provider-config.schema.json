{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseward.local/schemas/integration-provider-config.schema.json",
  "title": "TenantIntegrationConfig",
  "type": "object",
  "required": [
    "tenantKey",
    "messagingProviders",
    "calendarProviders",
    "messagingRouting",
    "calendarRouting"
  ],
  "properties": {
    "tenantKey": {
      "type": "string",
      "minLength": 2
    },
    "messagingProviders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "enabled", "displayName"],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "whatsapp-cloud-api",
              "telegram-bot",
              "generic-webhook",
              "email-smtp",
              "sms-gateway"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string"
          },
          "billing": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "enum": ["free", "paid"]
              },
              "adminActionRequired": {
                "type": "boolean"
              },
              "setupUrl": {
                "type": "string",
                "format": "uri"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "credentialsRef": {
            "type": "object",
            "required": ["secretKey"],
            "properties": {
              "secretKey": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "calendarProviders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "enabled", "displayName"],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "google-calendar",
              "apple-calendar",
              "outlook-calendar",
              "ics-calendar",
              "internal-calendar"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string"
          },
          "billing": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "enum": ["free", "paid"]
              },
              "adminActionRequired": {
                "type": "boolean"
              },
              "setupUrl": {
                "type": "string",
                "format": "uri"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "credentialsRef": {
            "type": "object",
            "required": ["secretKey"],
            "properties": {
              "secretKey": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "messagingRouting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["channel", "defaultProvider", "fallbackProviders"],
        "properties": {
          "channel": {
            "type": "string",
            "enum": ["patient-notification", "staff-notification", "website-hook"]
          },
          "defaultProvider": {
            "type": "string",
            "enum": [
              "whatsapp-cloud-api",
              "telegram-bot",
              "generic-webhook",
              "email-smtp",
              "sms-gateway"
            ]
          },
          "fallbackProviders": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "whatsapp-cloud-api",
                "telegram-bot",
                "generic-webhook",
                "email-smtp",
                "sms-gateway"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "calendarRouting": {
      "type": "object",
      "required": ["defaultProvider", "fallbackProviders"],
      "properties": {
        "defaultProvider": {
          "type": "string",
          "enum": [
            "google-calendar",
            "apple-calendar",
            "outlook-calendar",
            "ics-calendar",
            "internal-calendar"
          ]
        },
        "fallbackProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "google-calendar",
              "apple-calendar",
              "outlook-calendar",
              "ics-calendar",
              "internal-calendar"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
