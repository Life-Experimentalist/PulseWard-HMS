const request = require('supertest');
const app = require('../src/app'); // Adjust the path as necessary

describe('Patient Service API', () => {
    let patientId;

    // Test for creating a new patient
    it('should create a new patient', async () => {
        const newPatient = {
            name: 'John Doe',
            age: 30,
            gender: 'Male',
            medicalHistory: [],
        };

        const response = await request(app)
            .post('/api/patients')
            .send(newPatient)
            .expect(201);

        patientId = response.body.id; // Store the patient ID for later tests
        expect(response.body).toHaveProperty('id');
        expect(response.body.name).toBe(newPatient.name);
    });

    // Test for retrieving a patient by ID
    it('should retrieve a patient by ID', async () => {
        const response = await request(app)
            .get(`/api/patients/${patientId}`)
            .expect(200);

        expect(response.body).toHaveProperty('id', patientId);
        expect(response.body).toHaveProperty('name', 'John Doe');
    });

    // Test for updating a patient's information
    it('should update a patient\'s information', async () => {
        const updatedPatient = {
            name: 'John Doe Updated',
            age: 31,
            gender: 'Male',
            medicalHistory: ['Allergy to penicillin'],
        };

        const response = await request(app)
            .put(`/api/patients/${patientId}`)
            .send(updatedPatient)
            .expect(200);

        expect(response.body).toHaveProperty('name', updatedPatient.name);
    });

    // Test for deleting a patient
    it('should delete a patient', async () => {
        await request(app)
            .delete(`/api/patients/${patientId}`)
            .expect(204);
    });

    // Test for retrieving a non-existent patient
    it('should return 404 for a non-existent patient', async () => {
        await request(app)
            .get(`/api/patients/${patientId}`)
            .expect(404);
    });
});