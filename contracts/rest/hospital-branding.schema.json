{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseward.local/schemas/hospital-branding.schema.json",
  "title": "HospitalBrandingConfig",
  "type": "object",
  "required": [
    "tenantKey",
    "displayName",
    "legalName",
    "logo",
    "colors",
    "typography",
    "contact",
    "complianceCopy"
  ],
  "properties": {
    "tenantKey": {
      "type": "string",
      "minLength": 2
    },
    "displayName": {
      "type": "string",
      "minLength": 2
    },
    "legalName": {
      "type": "string",
      "minLength": 2
    },
    "tagline": {
      "type": "string"
    },
    "logo": {
      "type": "object",
      "required": ["light", "dark", "favicon", "appIcon"],
      "properties": {
        "light": {
          "type": "string"
        },
        "dark": {
          "type": "string"
        },
        "favicon": {
          "type": "string"
        },
        "appIcon": {
          "type": "string"
        }
      }
    },
    "colors": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "accent",
        "surface",
        "text",
        "success",
        "warning",
        "danger"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "success": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "warning": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "danger": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "typography": {
      "type": "object",
      "required": ["heading", "body", "baseScale"],
      "properties": {
        "heading": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "baseScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.4
        }
      }
    },
    "contact": {
      "type": "object",
      "required": ["supportEmail", "supportPhone", "website"],
      "properties": {
        "supportEmail": {
          "type": "string",
          "format": "email"
        },
        "supportPhone": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "complianceCopy": {
      "type": "object",
      "required": ["consentNotice", "privacyUrl"],
      "properties": {
        "consentNotice": {
          "type": "string"
        },
        "privacyUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "additionalProperties": false
}
