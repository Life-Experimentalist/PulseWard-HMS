{
    "version": "1.0.0",
    "owner": "platform-operations",
    "pilot": {
        "tenantKey": "citycare-hospital",
        "activeUserRange": {
            "min": 100,
            "max": 300
        },
        "goNoGoOwners": [
            "product-owner",
            "engineering-lead",
            "operations-lead"
        ]
    },
    "acceptanceCriteria": [
        {
            "key": "api-p95-latency",
            "description": "Pilot p95 API latency remains within agreed threshold.",
            "metric": "api.latency.p95.ms",
            "threshold": 1200
        },
        {
            "key": "api-error-rate",
            "description": "Pilot API error rate remains below release threshold.",
            "metric": "api.error.rate",
            "threshold": 0.03
        },
        {
            "key": "notification-delivery-success",
            "description": "Appointment reminder delivery success is stable during pilot.",
            "metric": "notification.delivery.success.rate",
            "threshold": 0.98
        }
    ],
    "cutoverChecklist": [
        {
            "key": "communications-approved",
            "description": "Stakeholder go-live communication package approved.",
            "required": true
        },
        {
            "key": "rollback-window-confirmed",
            "description": "Rollback window and ownership confirmed for cutover day.",
            "required": true
        },
        {
            "key": "runbook-links-validated",
            "description": "Incident, backup, and hypercare runbook links validated.",
            "required": true
        },
        {
            "key": "support-escalation-ready",
            "description": "Pilot support escalation channels and owners are ready.",
            "required": true
        }
    ],
    "hypercare": {
        "durationDays": 14,
        "dailyStandupTime": "09:30 IST",
        "triageSlaMinutes": 30,
        "hotfixPolicy": "Only safety, security, or patient-impacting fixes are allowed during hypercare without change board deferral.",
        "evidenceLogPath": "docs/runbooks/evidence"
    }
}